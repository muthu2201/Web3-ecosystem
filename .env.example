# Copy to .env and fill in. Never commit .env; CI scans for leaked secrets on every push.

# --- Deployment -------------------------------------------------------------
# Safe multisig that owns the fee router and receives the platform's share.
# A single EOA defeats the timelock: the point of the delay is that several
# people must agree and users can watch it happen.
SAFE_ADDRESS=

# Uniswap V2 / PancakeSwap V2 / Aerodrome router for the target chain.
DEX_ROUTER=

# Per-chain ceiling for flat fees, in wei. Bounded by ABSOLUTE_FLAT_NATIVE_CEILING.
FLAT_NATIVE_HARD_CAP=10000000000000000

# Delay between proposing and executing any parameter change, in seconds.
TIMELOCK_DELAY=172800

# --- RPC --------------------------------------------------------------------
BASE_RPC_URL=
BSC_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=

# --- Edge Worker secrets ----------------------------------------------------
# Set with `wrangler secret put`, not here. Listed for reference only.
# ZEROEX_API_KEY, GOPLUS_APP_KEY, ETHERSCAN_API_KEY, PINATA_JWT

# --- Front-end (public; anything here ships in the bundle) ------------------
VITE_EDGE_URL=
VITE_SWAP_FEE_BPS=25
VITE_DEPLOYMENTS=
