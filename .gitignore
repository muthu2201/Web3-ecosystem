# Dependencies
node_modules/
.pnpm-store/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# Contents are build output, but the directory itself must exist: Foundry's vm.writeFile
# cannot create a parent directory, so a missing artifacts/ fails the fixture generation and
# the local deployment on every fresh clone.
contracts/artifacts/*
!contracts/artifacts/.gitkeep
lcov.info

# Builds
dist/
build/
.turbo/
*.tsbuildinfo
.wrangler/
.astro/

# Env & secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
*.log
coverage/
